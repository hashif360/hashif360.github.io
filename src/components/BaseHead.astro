---
import { SITE, SOCIALS } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  authorName?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og-image.png',
  type = 'website',
  publishedTime,
  updatedTime,
  authorName = SITE.author,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const isHome = Astro.url.pathname === '/';

// JSON-LD structured data — homepage gets Person + WebSite, articles get BlogPosting.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
};

const blogPostingSchema =
  type === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: socialImage.toString(),
        datePublished: publishedTime.toISOString(),
        dateModified: (updatedTime ?? publishedTime).toISOString(),
        author: { '@type': 'Person', name: authorName, url: SITE.url },
        mainEntityOfPage: canonical.toString(),
      }
    : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#100f13" media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={authorName} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<!-- Structured data -->
{isHome && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
{isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
{blogPostingSchema && <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />}

<!-- Prevent theme flash: set data-theme before paint -->
<script is:inline>
  (() => {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored ?? (prefersDark ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  })();
</script>
